DEBUG_MESSAGES=1                 # add input prompts to nodes and conversation history for debugging
TRUNCATION_TOOL_LIMIT=120000       # truncation limit for characters in tool calls, and tool call 
DO_SELECTION=0                    # whether to use tool pool reduction mechanism
GATE_MAX_REACT_STEPS=10             # number of ReAct steps as gate node reactively repair errored tool calls
SHOW_PLANNER_HISTORY=1            # whether to show planner conversation history in debug messages
SHOW_PLANNER_TOOL_CONTEXT=0       # whether to show planner tool context in debug messages
SHOW_RESPONDER_HISTORY=1          # whether to show responder conversation history in debug messages
SHOW_GATE_INPUT=0                 # whether to show total gate input prompt in debug messages
SHOW_GATE_HISTORY=0               # whether to show gate conversation history in debug messages
SHOW_GATE_CACHED_TOOL_OUTPUTS=0   # whether to show cached tool outputs in gate debug messages
SHOW_GATE_FIXED_ERRORS=0          # whether to show fixed errors in gate debug messages
SHOW_GATE_UNRESOLVED_ERRORS=0     # whether to show unresolved errors in gate debug messages
SHOW_GATE_ATTEMPTED_REPAIRS=0     # whether to show attempted repairs in gate debug messages
SHOW_GATE_UNRESOLVED_ERROR_IDS=0  # whether to show unresolved error IDs in gate debug messages
SHOW_GATE_TOOL_OUTPUTS=1          # whether to show tool outputs in gate debug messages
TRUNCATION_LIMIT_PLANNER_HISTORY=10000    # truncation limit for planner history
TRUNCATION_LIMIT_PLANNER_TOOL=1000        # truncation limit for planner tool context
TRUNCATION_LIMIT_RESPONDER_HISTORY=10000  # truncation limit for responder history
TRUNCATION_LIMIT_GATE_HISTORY=10000       # truncation limit for gate history
TRUNCATION_LIMIT_GATE_TOOL_OUTPUT=500     # truncation limit for gate tool output
